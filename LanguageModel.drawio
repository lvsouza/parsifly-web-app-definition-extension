                <mxCell id="q7iplWRAef2PsvwGvNWv-602" value="Entidade que implementa tudo que uma Action precisa para ser executada. É Utilizada em outras entidades da aplicação. Nunca é usada sozinha" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" parent="K_odaD7vs8SB6yNQoxtx-1" vertex="1">
