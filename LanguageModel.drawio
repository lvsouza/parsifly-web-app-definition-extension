                <mxCell id="q7iplWRAef2PsvwGvNWv-607" value="Esse evento para um componente só pode ser &quot;escutado&quot; no local onde o componente é utilizado." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" parent="K_odaD7vs8SB6yNQoxtx-1" vertex="1">
