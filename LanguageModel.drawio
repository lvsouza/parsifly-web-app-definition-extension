                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="q7iplWRAef2PsvwGvNWv-605" value="O evento é declarado mas para funcionar ele precisa ser utilizado por um listener. Pode ser um listener local(na page ou component) ou um global do projeto" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" parent="K_odaD7vs8SB6yNQoxtx-1" vertex="1">
